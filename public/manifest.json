{
  "manifest_version": 3,
  "name": "webOS",
  "version": "0.1.0",
  "description": "A personal developer Desktop for the new tab.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "clipboardWrite",
    "history",
    "system.cpu",
    "system.memory"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ]
}
